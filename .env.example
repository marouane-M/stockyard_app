# Local demo only. No industrial credentials, PLC addresses or scanner drivers.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Leave blank to use the browser's hostname + BACKEND_PORT at runtime.
PUBLIC_API_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Illustrative real geographic anchor. NOT a surveyed location from the screenshots.
SITE_NAME=Parc de démonstration
SITE_ORIGIN_LAT=33.110
SITE_ORIGIN_LON=-8.610
SITE_ORIGIN_ALT_M=0
# Counterclockwise degrees from geographic East to the yard's positive travel axis.
SITE_HEADING_DEG=0

# Interactive imagery source. Configure a provider your organization is authorized to use.
MAP_ENABLED=true
MAP_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAP_ATTRIBUTION=Esri World Imagery · Sources : Esri, Maxar, Earthstar Geographics et contributeurs
